# Modelo versionado do .env. Copiar para .env e preencher:
#   cp .env.example .env
#
# Regra: apenas [A-Za-z0-9_-] nos valores. O Docker Compose interpola "$VAR"
# dentro dos valores do YAML, pelo que um "$" literal seria silenciosamente
# substituido por uma string vazia.

POSTGRES_DB=tickets_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
